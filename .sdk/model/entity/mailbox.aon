# Entity: mailbox

main: kit: entity: mailbox: {

  alias: field: {}

  fields: [
    {
      name: "domain"
      req: false
      short: "Optional domain for the temporary email address"
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      short: "Generated temporary email address"
      type: "`$STRING`"
    }
    {
      name: "expires_at"
      req: false
      short: "Unix timestamp when the mailbox expires"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the mailbox"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "mailbox"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/create"
          segments: [
            {
              lit: "create"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
