# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: email: {
    path: "/get-emails": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
  }

  entity: mailbox: {
    path: "/create": {
      op: create: method: *POST
      op: create: transform: res: *("`body.data`")|top
    }
  }

}